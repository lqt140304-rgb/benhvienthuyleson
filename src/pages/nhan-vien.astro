---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import TrangDau from '../components/ls/TrangDau.astro';
import { u } from '../lib/site';
---
<Layout title="Khu nhân viên" noindex>
  <TrangDau crumbs={[{ ten: 'Trang chủ', href: u('/') }, { ten: 'Khu nhân viên' }]} tieuDe="Khu nhân viên" moTa="Khu dành cho nhân viên (báo cáo spa, nội trú, bệnh án) đang được xây dựng.">
    <p style="margin-top:16px"><a class="nut nut-vien" href={u('/')}><Icon name="trai" size={18} />Về trang chủ</a></p>
  </TrangDau>
</Layout>
