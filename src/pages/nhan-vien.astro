---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/site';
---
<Layout title="Khu nhân viên" noindex>
  <section class="pagehead"><div class="wrap" style="max-width:720px">
    <h1><Icon name="lock" size={30} /> Khu nhân viên</h1>
    <p class="lead">Khu dành cho nhân viên (báo cáo spa, nội trú, bệnh án) đang được xây dựng.</p>
    <p><a class="btn btn-line" href={u('/')}>Về trang chủ</a></p>
  </div></section>
</Layout>
