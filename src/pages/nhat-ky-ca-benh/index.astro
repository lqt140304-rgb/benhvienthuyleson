---
import Layout from '../../layouts/Layout.astro';
import TrangDau from '../../components/ls/TrangDau.astro';
import CaseCard from '../../components/CaseCard.astro';
import { u, caBenh } from '../../lib/site';
const ds = await caBenh();
---
<Layout title="Nhật ký ca bệnh" description="Hình ảnh và câu chuyện các ca chó mèo được khám, phẫu thuật và điều trị tại Bệnh viện thú y Lê Sơn." hienTai="ca-benh" cam="ca_benh">
  <TrangDau crumbs={[{ ten: 'Trang chủ', href: u('/') }, { ten: 'Nhật ký ca bệnh' }]} nhan="Ca bệnh" tieuDe="Nhật ký ca bệnh" moTa="Các bé đã được khám và điều trị tại viện, kể lại bằng hình ảnh." />
  <section class="khoi" style="padding-top:24px">
    <div class="khung">
      {ds.length > 0 ? (
        <>
          <div class="tp-loc" role="group" aria-label="Lọc theo loài">
            <button type="button" data-loc="" aria-pressed="true">Tất cả</button>
            <button type="button" data-loc="Chó" aria-pressed="false">Chó</button>
            <button type="button" data-loc="Mèo" aria-pressed="false">Mèo</button>
          </div>
          <div class="tp-luoi" id="ds-ca">{ds.map((c) => <CaseCard ca={c} />)}</div>
          <p class="tp-rong" id="ca-trong" hidden>Chưa có ca nào trong mục này.</p>
        </>
      ) : <p class="tp-rong">Hình ảnh các ca bệnh được điều trị tại viện sẽ sớm được cập nhật.</p>}
      <p class="tp-luu-y" style="margin-top:28px">Ảnh được đăng khi có sự đồng ý của khách hàng. Web không hiển thị thông tin cá nhân của khách hàng.</p>
    </div>
  </section>
</Layout>
<script>
  // Lọc ca bệnh theo loài
  const nut = document.querySelectorAll<HTMLButtonElement>('[data-loc]');
  nut.forEach((b) => b.addEventListener('click', () => {
    const loai = b.dataset.loc;
    nut.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let con = 0;
    document.querySelectorAll<HTMLElement>('#ds-ca [data-loai]').forEach((c) => {
      const hien = !loai || c.dataset.loai === loai;
      c.hidden = !hien;
      if (hien) con++;
    });
    const trong = document.getElementById('ca-trong');
    if (trong) trong.hidden = con > 0;
  }));
</script>
