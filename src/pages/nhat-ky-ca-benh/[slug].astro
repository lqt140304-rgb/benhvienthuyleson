---
// Trang một ca bệnh: album ảnh + tóm tắt. Ảnh nhạy cảm bị làm mờ cho tới khi khách bấm xem.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import TrangDau from '../../components/ls/TrangDau.astro';
import CaseCard from '../../components/CaseCard.astro';
import tt from '../../data/thong_tin.json';
import { u, ngay, caBenh } from '../../lib/site';

export async function getStaticPaths() {
  const ds = await caBenh();
  return ds.map((ca) => ({ params: { slug: ca.id }, props: { ca, ds } }));
}
const { ca, ds } = Astro.props;
const d = ca.data;
const { Content } = await render(ca);
const anh = d.anh.length > 0 ? d.anh : d.image ? [{ src: d.image, chu_thich: '' }] : [];
const khac = ds.filter((c) => c.id !== ca.id).slice(0, 3);
---
<Layout title={d.title} description={d.tom_tat || `Ca bệnh ${d.loai.toLowerCase()} điều trị tại ${tt.ten}.`} image={d.nhay_cam ? undefined : (d.image || anh[0]?.src)} cam="ca_benh" hienTai="ca-benh" article>
  <TrangDau crumbs={[{ ten: 'Trang chủ', href: u('/') }, { ten: 'Nhật ký ca bệnh', href: u('/nhat-ky-ca-benh/') }, { ten: d.title }]} nhan={d.loai} tieuDe={d.title}>
    <div class="tp-bai-meta"><span>{ngay(d.date)}</span>{d.bac_si && <span>· Bác sĩ phụ trách: {d.bac_si}</span>}</div>
  </TrangDau>
  <section class="khoi" style="padding-top:8px">
    <div class="khung" style="max-width:1000px">
      {d.tom_tat && <p class="tp-lead">{d.tom_tat}</p>}
      {d.nhay_cam && anh.length > 0 && <p class="tp-luu-y-do"><Icon name="alert" size={18} />Ca này có ảnh phẫu thuật hoặc vết thương. Ảnh đang được làm mờ, bấm vào từng ảnh để xem.</p>}
      {anh.length > 0 && (
        <div class="tp-album">
          {anh.map((a) => (
            <figure>
              {d.nhay_cam
                ? <button type="button" class="tp-anh-nc" aria-label={`Xem ảnh${a.chu_thich ? ': ' + a.chu_thich : ''}`} data-xem>
                    <img src={u(a.src)} alt={a.chu_thich} loading="lazy" width="600" height="450">
                    <span class="tp-mo-nhan"><Icon name="eye" size={24} />Bấm để xem ảnh</span>
                  </button>
                : <img src={u(a.src)} alt={a.chu_thich} loading="lazy" width="600" height="450">}
              {a.chu_thich && <figcaption>{a.chu_thich}</figcaption>}
            </figure>
          ))}
        </div>
      )}
      <div class="tp-prose"><Content /></div>
      <div class="tp-ket-bai">
        <div><h2>Bé nhà bạn có dấu hiệu tương tự?</h2><p>Đặt lịch để bác sĩ khám và tư vấn trực tiếp.</p></div>
        <div class="hang-nut"><a class="nut nut-chinh" href={u('/dat-lich/')}><Icon name="calendar" size={18} />Đặt lịch khám</a><a class="nut nut-vien" href={`tel:${tt.dien_thoai_goi}`}><Icon name="phone" size={18} />Gọi</a></div>
      </div>
    </div>
  </section>
  {khac.length > 0 && (
    <section class="khoi khoi-kem">
      <div class="khung">
        <div class="dau-khoi hang"><div><h2>Ca bệnh khác</h2></div><a class="link-mui" href={u('/nhat-ky-ca-benh/')}>Xem tất cả <Icon name="arrow" size={18} /></a></div>
        <div class="tp-luoi">{khac.map((c) => <CaseCard ca={c} />)}</div>
      </div>
    </section>
  )}
</Layout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-xem]').forEach((b) => b.addEventListener('click', () => {
    b.classList.add('da-xem');
    b.setAttribute('aria-label', 'Ảnh đã hiện');
  }));
</script>
