---
// Trang Đặt lịch: biểu mẫu mới (chế độ do src/lib/dat-lich.ts quyết định; mặc định giả lập) hoặc biểu mẫu cũ nếu modeDatLich = 'cu'.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import TrangDau from '../components/ls/TrangDau.astro';
import FormDatLich from '../components/ls/FormDatLich.astro';
import FormDatLichCu from '../components/ls/FormDatLichCu.astro';
import tt from '../data/thong_tin.json';
import pp from '../data/phu_phi.json';
import { u, gia } from '../lib/site';
import { modeDatLich } from '../lib/dat-lich';
const phiCapCuu = tt.phu_phi_cap_cuu_ngoai_gio || 'vui lòng gọi để biết mức';
const cu = modeDatLich === 'cu';
---
<Layout title="Đặt lịch khám" description={`Gửi yêu cầu đặt lịch khám, tiêm phòng, grooming, triệt sản, gửi nội trú cho chó mèo tại ${tt.ten}. Nhân viên sẽ liên hệ xác nhận.`} cam="dat_lich" hienTai="dat-lich">
  <TrangDau crumbs={[{ ten: 'Trang chủ', href: u('/') }, { ten: 'Đặt lịch' }]} nhan="Đặt lịch" tieuDe="Đặt lịch cho bé" moTa={cu ? 'Chọn dịch vụ và giờ hẹn, web tự tính hoá đơn tham khảo. Nhân viên sẽ gọi lại để xác nhận.' : 'Gửi yêu cầu đặt lịch, nhân viên sẽ liên hệ xác nhận. Lịch chỉ được xác nhận khi bệnh viện liên hệ với bạn.'} />
  {cu
    ? <FormDatLichCu />
    : (
      <section class="khoi" style="padding-top:24px">
        <div class="khung dl-trang">
          <div class="dl-cot-form"><FormDatLich /></div>
          <aside class="dl-ben">
            {tt.zalo && (
              <div class="dl-ben-the">
                <h2>Nhắn Zalo cho bệnh viện</h2>
                <p>Hỏi nhanh, gửi ảnh bé, hẹn giờ trực tiếp với nhân viên.</p>
                <a class="nut nut-vien" href={tt.zalo} target="_blank" rel="noopener"><Icon name="chat" size={18} />Nhắn Zalo</a>
              </div>
            )}
            <div class="dl-ben-the dl-ben-cam">
              <h2><Icon name="clock" size={20} />Ngoài giờ mở cửa ({tt.gio_mo_cua})</h2>
              <p>Cần khám ngoài giờ hoặc cấp cứu, vui lòng gọi trực tiếp. Phụ phí khám ngoài giờ (cộng thêm):</p>
              <ul>
                {pp.kham_ngoai_gio.map((k) => <li>{k.tu} – {k.den}: <b>{gia(k.gia)}</b></li>)}
                <li>Phụ phí cấp cứu ngoài giờ: <b>{phiCapCuu}</b></li>
              </ul>
              <a class="nut nut-chinh" href={`tel:${tt.dien_thoai_goi}`}><Icon name="phone" size={18} />{tt.dien_thoai}</a>
            </div>
            <div class="dl-ben-the">
              <h2>Sau khi gửi</h2>
              <p>Nhân viên liên hệ để xác nhận giờ. Lịch chỉ chắc chắn khi bệnh viện đã liên hệ xác nhận với bạn.</p>
            </div>
          </aside>
        </div>
      </section>
    )}
</Layout>
