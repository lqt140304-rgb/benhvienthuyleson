---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import tt from '../data/thong_tin.json';
import dv from '../data/dich_vu.json';
import { u } from '../lib/site';
const goiMuc = 'Vui lòng gọi để biết mức';
---
<Layout title="Dịch vụ và bảng giá" description={`Khám chữa bệnh, tiêm phòng, phẫu thuật, spa, nội trú và cấp cứu 24/24 cho chó mèo tại ${tt.ten}. Bảng giá tham khảo.`} cam="dich_vu">
  <section class="pagehead"><div class="wrap">
    <nav class="crumb" aria-label="Đường dẫn"><a href={u('/')}>Trang chủ</a><span aria-hidden="true">›</span><span>Dịch vụ & bảng giá</span></nav>
    <h1>Dịch vụ và bảng giá</h1>
    <p class="lead">Giá mang tính tham khảo; chi phí chính xác bác sĩ sẽ báo sau khi khám.</p>
  </div></section>
  <section class="s" style="padding-top:8px">
    <div class="wrap" style="max-width:900px">
      {dv.danh_sach.map((d) => (
        <article class={`dv${d.cap_cuu ? ' cc' : ''}`} id={d.ten.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/gi, 'd').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>
          <span class="dv-ic"><Icon name={d.icon} size={26} /></span>
          <h2>{d.ten}</h2>
          <p class="muted" style="margin:0">{d.mo_ta}</p>
          <div>
            {d.hang_muc.length > 0 && (
              <table class="gia">
                <tbody>
                  {d.hang_muc.map((h) => <tr><td>{h.ten}</td><td class={h.gia ? '' : 'cho-gia'}>{h.gia || 'Đang cập nhật'}</td></tr>)}
                  {d.cap_cuu && <>
                    <tr><td>Phụ phí khám ngoài giờ (trước 8:00, sau 21:00)</td><td class={tt.phu_phi_kham_ngoai_gio ? '' : 'cho-gia'}>{tt.phu_phi_kham_ngoai_gio || goiMuc}</td></tr>
                    <tr><td>Phụ phí cấp cứu ngoài giờ</td><td class={tt.phu_phi_cap_cuu_ngoai_gio ? '' : 'cho-gia'}>{tt.phu_phi_cap_cuu_ngoai_gio || goiMuc}</td></tr>
                  </>}
                </tbody>
              </table>
            )}
            <div class="dv-nut">
              {d.cap_cuu
                ? <a class="btn btn-cta" href={`tel:${tt.dien_thoai_goi}`}><Icon name="phone" />Gọi cấp cứu {tt.dien_thoai}</a>
                : <a class="btn btn-cta btn-sm" href={u(`/dat-lich/?dv=${encodeURIComponent(d.ten)}`)}>Đặt lịch {d.ten.toLowerCase()}</a>}
              {tt.zalo && <a class="btn btn-line btn-sm" href={tt.zalo} target="_blank" rel="noopener">Hỏi giá qua Zalo</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
