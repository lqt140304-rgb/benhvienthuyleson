---
// Tất cả dịch vụ: mỗi nhóm một khối có mô tả, bảng giá đầy đủ (dữ liệu nguyên gốc) và nút đặt lịch
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import OIc from '../components/ls/OIc.astro';
import TrangDau from '../components/ls/TrangDau.astro';
import BangGiaNhom from '../components/ls/BangGiaNhom.astro';
import tt from '../data/thong_tin.json';
import { u } from '../lib/site';
import { dichVuLS } from '../lib/ls';
const dv = dichVuLS();
---
<Layout title="Dịch vụ và bảng giá" description={`Bảng giá khám, xét nghiệm, grooming, triệt sản, gửi nội trú cho chó mèo tại ${tt.ten}.`} hienTai="dich-vu" cam="dich_vu">
  <TrangDau crumbs={[{ ten: 'Trang chủ', href: u('/') }, { ten: 'Dịch vụ & bảng giá' }]} nhan="Dịch vụ" tieuDe="Dịch vụ và bảng giá" moTa="Giá tham khảo; chưa gồm thuốc, vật tư phát sinh. Nhân viên báo chi phí cụ thể khi xác nhận lịch.">
    <nav class="tp-loc" aria-label="Nhóm dịch vụ" style="margin:20px 0 0">{dv.map((d) => <a href={`#${d.id}`}>{d.ten}</a>)}</nav>
  </TrangDau>
  <section class="khoi" style="padding-top:24px">
    <div class="khung" style="max-width:960px">
      {dv.map((d) => (
        <article class="dv-khoi" id={d.id}>
          <div class="bg-dau">
            <OIc name={d.icon} dv />
            <div><h2>{d.ten}</h2><p>{d.mo_ta}</p></div>
          </div>
          <BangGiaNhom d={d} />
          <div class="tp-cta-hang">
            {d.cap_cuu
              ? <a class="nut nut-chinh" href={`tel:${tt.dien_thoai_goi}`}><Icon name="phone" size={18} />Gọi {tt.dien_thoai}</a>
              : d.dat_lich && <a class="nut nut-chinh" href={u(`/dat-lich/?nhom=${encodeURIComponent(d.id)}`)}>Đặt lịch {d.ten.toLowerCase().replace(/ \(.*\)$/, '')}</a>}
            {tt.zalo && <a class="nut nut-vien" href={tt.zalo} target="_blank" rel="noopener">Hỏi qua Zalo</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
