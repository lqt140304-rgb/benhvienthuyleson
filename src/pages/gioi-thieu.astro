---
import { marked } from 'marked';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import TrangDau from '../components/ls/TrangDau.astro';
import AnhCho from '../components/ls/AnhCho.astro';
import tt from '../data/thong_tin.json';
import bs from '../data/bac_si.json';
import csvc from '../data/co_so_vat_chat.json';
import { u, dsDichVu } from '../lib/site';
const soNhom = dsDichVu().length;
const gioiThieu = tt.gioi_thieu ? await marked.parse(tt.gioi_thieu) : '';
const bacSi = (bs as any).danh_sach.length > 0 ? (bs as any).danh_sach : null;
---
<Layout title="Giới thiệu bệnh viện" description={`Giới thiệu ${tt.ten}: đội ngũ bác sĩ, cơ sở vật chất, dịch vụ khám chữa bệnh cho chó mèo tại ${tt.dia_chi}.`} hienTai="gioi-thieu" cam="trang_khac">
  <TrangDau crumbs={[{ ten: 'Trang chủ', href: u('/') }, { ten: 'Giới thiệu' }]} nhan="Giới thiệu" tieuDe={tt.ten} moTa={tt.gioi_thieu_ngan || `Bệnh viện thú y chuyên chó mèo tại ${tt.dia_chi}.`} />

  <section class="khoi" style="padding-top:24px">
    <div class="khung">
      <div class="tp-so-lieu">
        <div><b>{tt.gio_mo_cua}</b>Giờ mở cửa</div>
        {tt.so_nam_hoat_dong && <div><b>{tt.so_nam_hoat_dong} năm</b>Hoạt động</div>}
        <div><b>{soNhom}</b>Nhóm dịch vụ</div>
      </div>
      <div class="tp-hai-cot">
        {tt.anh_tap_the
          ? <img src={u(tt.anh_tap_the)} alt={`Đội ngũ ${tt.ten}`} width="600" height="400" style="aspect-ratio:3/2;object-fit:cover;width:100%;border-radius:var(--r-lon)">
          : <AnhCho goiY="Ảnh tập thể bác sĩ, nhân viên" />}
        <div class="tp-prose">
          {gioiThieu ? <Fragment set:html={gioiThieu} /> : <p class="muted">Phần giới thiệu chi tiết về bệnh viện đang được cập nhật.</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="khoi khoi-tim">
    <div class="khung">
      <div class="dau-khoi"><h2>Đội ngũ bác sĩ</h2></div>
      <div class="tp-luoi tp-luoi-4">
        {bacSi
          ? bacSi.map((b: any) => (
              <div class="tp-bs">
                <div class="tp-hinh">{b.anh ? <img src={u(b.anh)} alt={b.ten} loading="lazy" width="300" height="300"> : <span aria-hidden="true">Ảnh</span>}</div>
                <b>{b.ten}</b>{b.chuc_vu && <span class="tp-meta">{b.chuc_vu}</span>}
              </div>
            ))
          : [1, 2, 3, 4].map(() => <div class="tp-bs"><div class="tp-hinh" aria-hidden="true">Ảnh bác sĩ · chờ bổ sung</div><b class="tp-meta">Đang cập nhật</b></div>)}
      </div>
    </div>
  </section>

  <section class="khoi">
    <div class="khung">
      <div class="dau-khoi"><h2>Cơ sở vật chất</h2></div>
      <div class="tp-luoi">
        {csvc.danh_sach.map((c) => (
          <figure class="tp-the" style="margin:0">
            <div class="tp-hinh">{c.anh ? <img src={u(c.anh)} alt={c.ten} loading="lazy" width="400" height="300"> : <span aria-hidden="true">Ảnh {c.ten.toLowerCase()} (đang cập nhật)</span>}</div>
            <figcaption class="tp-noi"><h3>{c.ten}</h3></figcaption>
          </figure>
        ))}
      </div>
      <p class="tp-cta-hang"><a class="nut nut-chinh" href={u('/dat-lich/')}><Icon name="calendar" size={18} />Đặt lịch khám</a></p>
    </div>
  </section>
</Layout>
