---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import OIc from '../components/ls/OIc.astro';
import TrangDau from '../components/ls/TrangDau.astro';
import tt from '../data/thong_tin.json';
import { u } from '../lib/site';
import { choXn } from '../lib/ls';
const banDo = 'https://www.google.com/maps?q=' + encodeURIComponent('Bệnh viện thú y Lê Sơn, ' + tt.dia_chi) + '&output=embed';
const leTet = choXn('gio-ngay-le');
---
<Layout title="Liên hệ" description={`Địa chỉ ${tt.ten}: ${tt.dia_chi}. Điện thoại ${tt.dien_thoai}. Mở cửa ${tt.gio_mo_cua}.`} hienTai="lien-he" cam="trang_khac">
  <TrangDau crumbs={[{ ten: 'Trang chủ', href: u('/') }, { ten: 'Liên hệ' }]} nhan="Liên hệ" tieuDe="Liên hệ và chỉ đường" />
  <section class="khoi" style="padding-top:24px">
    <div class="khung tp-hai-cot">
      <div>
        <dl class="lh-ds">
          <div><OIc name="pin" /><dt>Địa chỉ</dt><dd>{tt.dia_chi}</dd></div>
          <div><OIc name="clock" /><dt>Giờ mở cửa</dt><dd>{tt.gio_mo_cua}{leTet && <small class="xn-dong">{leTet.ghi_chu_hien} <span class="cho-xn">Chờ xác nhận</span></small>}</dd></div>
          <div><OIc name="phone" /><dt>Điện thoại</dt><dd><a href={`tel:${tt.dien_thoai_goi}`}>{tt.dien_thoai}</a></dd></div>
          {tt.zalo && <div><OIc name="chat" /><dt>Zalo</dt><dd><a href={tt.zalo} target="_blank" rel="noopener">Nhắn Zalo cho bệnh viện</a></dd></div>}
          {tt.facebook && <div><OIc name="facebook" /><dt>Facebook</dt><dd><a href={tt.facebook} target="_blank" rel="noopener">Trang Facebook của bệnh viện</a></dd></div>}
        </dl>
        <div class="tp-cta-hang">
          <a class="nut nut-chinh" href={tt.ban_do} target="_blank" rel="noopener"><Icon name="dinhvi" size={18} />Chỉ đường Google Maps</a>
          <a class="nut nut-vien" href={u('/dat-lich/')}>Đặt lịch khám</a>
        </div>
      </div>
      <iframe class="tp-iframe" src={banDo} title={`Bản đồ đến ${tt.ten}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Layout>
