---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import IconMau from '../components/IconMau.astro';
import PostCard from '../components/PostCard.astro';
import CaseCard from '../components/CaseCard.astro';
import TrangTri from '../components/TrangTri.astro';
import tt from '../data/thong_tin.json';
import dg from '../data/danh_gia.json';
import { u, ngay, neo, giaTu, baiTuVan, caBenh, dsDichVu } from '../lib/site';
const dv = dsDichVu();

const bai = await baiTuVan();
const noiBat = bai.find((b) => b.data.noi_bat);
const moiDang = bai.filter((b) => b !== noiBat).slice(0, 3);
const soBai = (loai: string) => bai.filter((b) => b.data.chuyen_muc === loai).length;
const ca = (await caBenh()).slice(0, 4);
// Đánh giá của khách: chép nguyên văn từ Google Maps / Facebook trong trang quản trị
const linkGoogle = dg.link_google || tt.ban_do;
const linkFb = dg.link_facebook || (tt.facebook ? tt.facebook.split('?')[0].replace(/\/$/, '') + '/reviews' : '');
const danhGia = (dg.danh_sach as any[]).filter((d) => d && d.ten && d.noi_dung);
const nguonDg = [
  { ten: 'Google Maps', icon: 'pin', diem: dg.diem_google, so: dg.so_danh_gia_google, link: linkGoogle },
  { ten: 'Facebook', icon: 'facebook', diem: dg.diem_facebook, so: dg.so_danh_gia_facebook, link: linkFb },
].filter((n) => n.link);
const soSao = (d: string) => Math.max(0, Math.min(5, parseFloat(String(d).replace(',', '.')) || 0));
---
<Layout cam="trang_chu">

<section class="hero">
  <TrangTri kieu="hero" />
  <div class="wrap hero-in">
    <div class="hero-main">
      {noiBat ? (
        <a class="feat" href={u(`/tu-van/${noiBat.id}/`)}>
          {noiBat.data.image && <img class="anh" src={u(noiBat.data.image)} alt="" width="1200" height="675" fetchpriority="high">}
          <span class={`kicker${noiBat.data.chuyen_muc === 'Chó' ? ' cho' : ''}`}>Bài nổi bật · {noiBat.data.chuyen_muc}</span>
          <h1>{noiBat.data.title}</h1>
          {noiBat.data.description && <p class="lead">{noiBat.data.description}</p>}
          <span class="muted">{noiBat.data.tac_gia ? `${noiBat.data.tac_gia} · ` : ''}{ngay(noiBat.data.date)}</span>
        </a>
      ) : (
        <>
          <span class="kicker">Bệnh viện thú y · Thanh Xuân, Hà Nội</span>
          <h1>Chăm sóc chó mèo tận tâm, như người nhà</h1>
          <p class="lead">Khám chữa bệnh, tiêm phòng, phẫu thuật, spa và nội trú cho chó mèo. Mở cửa {tt.gio_mo_cua}, trực cấp cứu 24/24.</p>
        </>
      )}
      <div class="dv-nut">
        <a class="btn btn-cta" href={u('/dat-lich/')}><Icon name="calendar" />Đặt lịch khám</a>
        <a class="btn btn-line" href={`tel:${tt.dien_thoai_goi}`}><Icon name="phone" />{tt.dien_thoai}</a>
      </div>
    </div>
    <aside class="box-tim">
      <h2>Đặt lịch trong 3 bước</h2>
      <ol class="buoc">
        <li><span>1</span>Chọn dịch vụ, giờ hẹn trên web hoặc nhắn Zalo. Web tính sẵn hoá đơn tham khảo.</li>
        <li><span>2</span>Nhân viên gọi lại xác nhận lịch.</li>
        <li><span>3</span>Đưa bé đến {tt.dia_chi.split(',')[0]} đúng giờ hẹn.</li>
      </ol>
      {tt.zalo && <a class="btn btn-trang" href={tt.zalo} target="_blank" rel="noopener"><Icon name="chat" />Nhắn Zalo</a>}
      <p class="cc">Cấp cứu 24/24: <a href={`tel:${tt.dien_thoai_goi}`}>{tt.dien_thoai}</a></p>
    </aside>
  </div>
</section>

<section class="s co-tt">
  <TrangTri kieu="ve" />
  <div class="wrap ve">
    {tt.anh_tap_the
      ? <img class="ve-anh" src={u(tt.anh_tap_the)} alt={`Đội ngũ ${tt.ten}`} loading="lazy" width="600" height="450">
      : <div class="ve-anh cho-trong">Ảnh tập thể bác sĩ, nhân viên (đang cập nhật)</div>}
    <div>
      <span class="kicker">Về chúng tôi</span>
      <h2>{tt.ten}</h2>
      <p class="muted">{tt.gioi_thieu_ngan || `Bệnh viện thú y chuyên chó mèo tại ${tt.dia_chi}. Mở cửa ${tt.gio_mo_cua} hằng ngày và trực cấp cứu 24/24.`}</p>
      <ul class="chip">
        <li>Trực cấp cứu 24/24</li>
        <li>Siêu âm · X-quang · Xét nghiệm</li>
        <li>Spa & nội trú</li>
        {tt.so_nam_hoat_dong && <li>{tt.so_nam_hoat_dong} năm hoạt động</li>}
      </ul>
      <a class="btn btn-line" href={u('/gioi-thieu/')}>Xem thêm về bệnh viện <Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>

<section class="s s-tim co-tt">
  <TrangTri kieu="cam-nang" />
  <div class="wrap">
    <div class="sh"><h2>Cẩm nang thú cưng</h2><a href={u('/tu-van/')}>Xem tất cả <Icon name="arrow" size={16} /></a></div>
    <div class="loai">
      <a href={u('/tu-van/cho/')}><span class="loai-ic cho"><IconMau name="dog" size={84} /></span><span><h3>Chó</h3><span>{soBai('Chó') ? `${soBai('Chó')} bài · ` : ''}Phòng bệnh, dinh dưỡng, dấu hiệu cần đi khám.</span></span></a>
      <a href={u('/tu-van/meo/')}><span class="loai-ic"><IconMau name="cat" size={84} /></span><span><h3>Mèo</h3><span>{soBai('Mèo') ? `${soBai('Mèo')} bài · ` : ''}Chăm sóc mèo con, mèo trưởng thành, tiêm phòng, triệt sản.</span></span></a>
    </div>
    {moiDang.length > 0
      ? <div class="grid3" style="margin-top:28px">{moiDang.map((b) => <PostCard bai={b} />)}</div>
      : <p class="empty" style="margin-top:28px">Bài viết đang được bác sĩ chuẩn bị và sẽ sớm có mặt tại đây.</p>}
  </div>
</section>

<section class="s co-tt">
  <TrangTri kieu="ca-benh" />
  <div class="wrap">
    <div class="sh"><h2>Nhật ký ca bệnh</h2><a href={u('/nhat-ky-ca-benh/')}>Xem tất cả <Icon name="arrow" size={16} /></a></div>
    {ca.length > 0
      ? <div class="grid4">{ca.map((c) => <CaseCard ca={c} />)}</div>
      : <p class="empty">Hình ảnh các ca bệnh được điều trị tại viện sẽ sớm được cập nhật.</p>}
  </div>
</section>

<section class="s s-cam co-tt">
  <TrangTri kieu="dich-vu" />
  <div class="wrap">
    <div class="sh"><h2>Dịch vụ tại bệnh viện</h2><a href={u('/dich-vu/')}>Bảng giá đầy đủ <Icon name="arrow" size={16} /></a></div>
    <div class="dv-list">
      {dv.map((d) => (
        <a class={d.cap_cuu ? 'cc' : ''} href={u(`/dich-vu/#${neo(d.ten)}`)}>
          <span class={`dv-ic n-${d.icon}`}><IconMau name={d.icon} size={46} /></span>
          <b>{d.ten}</b>
          <span>{d.mo_ta}</span>
          <span class="dv-gia">{d.cap_cuu ? `Gọi ${tt.dien_thoai}` : giaTu(d) || 'Xem bảng giá'}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="s danh-gia-khu">
  <div class="wrap">
    <div class="sh"><h2>Khách hàng nói gì về Lê Sơn</h2></div>
    <div class="dg-tong">
      {nguonDg.map((n) => (
        <a class="dg-nguon" href={n.link} target="_blank" rel="noopener">
          <span class={`dg-nguon-ic ${n.icon}`}><Icon name={n.icon} size={26} /></span>
          <span>
            <b>{n.ten}</b>
            {n.diem
              ? <span class="dg-diem"><strong>{n.diem}</strong><span class="sao" style={`--sao:${soSao(n.diem)}`} aria-label={`${n.diem} trên 5 sao`}></span>{n.so && <small>{n.so} đánh giá</small>}</span>
              : <span class="muted">Xem và viết đánh giá</span>}
          </span>
          <Icon name="arrow" size={18} />
        </a>
      ))}
    </div>
    {danhGia.length > 0 ? (
      <div class="dg-hang" tabindex="0" aria-label="Các đánh giá của khách hàng, cuộn ngang để xem thêm">
        {danhGia.map((d) => (
          <figure class="dg-the">
            <span class="sao" style={`--sao:${Math.max(1, Math.min(5, Number(d.sao) || 5))}`} aria-label={`${d.sao || 5} sao`}></span>
            <blockquote>{d.noi_dung}</blockquote>
            <figcaption>
              <span class="dg-chu" aria-hidden="true">{String(d.ten).trim().charAt(0).toUpperCase()}</span>
              <span><b>{d.ten}</b><small>{[d.be, d.nguon, d.thoi_gian].filter(Boolean).join(' · ')}</small></span>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p class="empty">Đánh giá thật của khách hàng trên Google Maps và Facebook sẽ được hiển thị tại đây. Bạn đã đưa bé đến Lê Sơn? Hãy để lại vài lời nhé!</p>
    )}
    <div class="dv-nut dg-nut">
      <a class="btn btn-cta" href={linkGoogle} target="_blank" rel="noopener"><Icon name="pin" />Đánh giá trên Google Maps</a>
      {linkFb && <a class="btn btn-line" href={linkFb} target="_blank" rel="noopener"><Icon name="facebook" />Đánh giá trên Facebook</a>}
    </div>
  </div>
</section>

</Layout>
