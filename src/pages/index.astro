---
// Trang chủ: ghép các khu (mỗi khu là một component trong src/components/ls/ cho giao diện R3.6, src/components/moi/ cho giao diện mới; chọn theo GIAO_DIEN trong src/lib/site.ts)
import Layout from '../layouts/Layout.astro';
import { GIAO_DIEN } from '../lib/site';
import Hero from '../components/ls/Hero.astro';
import GioiThieu from '../components/ls/GioiThieu.astro';
import HeroMoi from '../components/moi/Hero.astro';
import GioiThieuDichVuMoi from '../components/moi/GioiThieuDichVu.astro';
import SanPhamMoi from '../components/moi/SanPham.astro';
import GiaGonMoi from '../components/moi/GiaGon.astro';
import DichVuNoiBat from '../components/ls/DichVuNoiBat.astro';
import SanPham from '../components/ls/SanPham.astro';
import GiaGon from '../components/ls/GiaGon.astro';
import DatLichKhu from '../components/ls/DatLichKhu.astro';
import DoiNgu from '../components/ls/DoiNgu.astro';
import CamNang from '../components/ls/CamNang.astro';
import CauChuyen from '../components/ls/CauChuyen.astro';
import DanhGia from '../components/ls/DanhGia.astro';
import LienHe from '../components/ls/LienHe.astro';
---
<Layout trang="chu" cam="trang_chu">
  {GIAO_DIEN === 'moi' ? <HeroMoi /> : <Hero />}
  {GIAO_DIEN === 'moi' ? <GioiThieuDichVuMoi /> : <><GioiThieu /><DichVuNoiBat /></>}
  {GIAO_DIEN === 'moi' ? <SanPhamMoi /> : <SanPham />}
  {GIAO_DIEN === 'moi' ? <GiaGonMoi /> : <GiaGon />}
  <DatLichKhu />
  <DoiNgu />
  <CamNang />
  <CauChuyen />
  <DanhGia />
  <LienHe />
</Layout>
