---
// Bé Cam – mèo cam hướng dẫn, ngồi góc màn hình, đưa gợi ý theo từng trang.
// Câu nói sửa trong trang quản trị: "Thông tin & cài đặt" → "Bé Cam" (src/data/cam.json).
import Icon from './Icon.astro';
import cam from '../data/cam.json';
import tt from '../data/thong_tin.json';
import { u } from '../lib/site';

interface Props { trang?: string }
const { trang = 'trang_khac' } = Astro.props;
const tel = `tel:${tt.dien_thoai_goi}`;

type NutCam = { ten: string; href: string; chinh?: boolean; ngoai?: boolean };
const goi: Record<string, { cau: string; nut: NutCam[] }> = {
  ngoai_gio: { cau: cam.ngoai_gio, nut: [{ ten: `Gọi ${tt.dien_thoai}`, href: tel, chinh: true }, { ten: 'Đặt lịch hôm sau', href: u('/dat-lich/') }] },
  trang_chu: { cau: cam.trang_chu, nut: [{ ten: 'Bé là chó', href: u('/tu-van/cho/'), chinh: true }, { ten: 'Bé là mèo', href: u('/tu-van/meo/'), chinh: true }] },
  bai_viet: { cau: cam.bai_viet, nut: [{ ten: 'Đặt lịch khám', href: u('/dat-lich/'), chinh: true }, { ten: 'Gọi bệnh viện', href: tel }] },
  dich_vu: { cau: cam.dich_vu, nut: tt.zalo ? [{ ten: 'Nhắn Zalo', href: tt.zalo, chinh: true, ngoai: true }, { ten: 'Gọi bệnh viện', href: tel }] : [{ ten: 'Gọi bệnh viện', href: tel, chinh: true }] },
  ca_benh: { cau: cam.ca_benh, nut: [{ ten: 'Cẩm nang thú cưng', href: u('/tu-van/') }] },
  dat_lich: { cau: cam.dat_lich, nut: [] },
  trang_khac: { cau: cam.trang_khac, nut: [{ ten: 'Đặt lịch khám', href: u('/dat-lich/'), chinh: true }, { ten: 'Cẩm nang thú cưng', href: u('/tu-van/') }, { ten: 'Gọi', href: tel }] },
};
const loai = goi[trang] ? trang : 'trang_khac';
const hien = ['ngoai_gio', loai];
---
{cam.bat && (
<div class="cam" id="cam" data-trang={loai} hidden>
  <div class="cam-bong" id="cam-bong" role="region" aria-label="Gợi ý của bé Cam" hidden>
    <button type="button" class="cam-x" data-cam-nho aria-label="Thu nhỏ bé Cam"><Icon name="minus" size={18} /></button>
    <p class="cam-ten">Cam</p>
    {hien.map((k) => (
      <div class="cam-goi-y" data-goi-y={k} hidden>
        <p class="cam-cau">{goi[k].cau}</p>
        {goi[k].nut.length > 0 && (
          <div class="cam-nut">
            {goi[k].nut.map((n) => (
              <a class={n.chinh ? 'btn btn-cta btn-sm' : 'btn btn-line btn-sm'} href={n.href} target={n.ngoai ? '_blank' : undefined} rel={n.ngoai ? 'noopener' : undefined}>{n.ten}</a>
            ))}
          </div>
        )}
      </div>
    ))}
    <button type="button" class="cam-tat linklike" data-cam-tat>Tắt bé Cam</button>
  </div>
  <button type="button" class="cam-meo" id="cam-meo" aria-expanded="false" aria-controls="cam-bong" aria-label="Bé Cam – bấm để xem gợi ý">
    <svg viewBox="0 0 120 132" width="92" height="101" aria-hidden="true">
      <g class="cam-duoi"><path d="M86 112c22-2 30-24 18-40" fill="none" stroke="#2B0D2E" stroke-width="14" stroke-linecap="round"/><path d="M86 112c22-2 30-24 18-40" fill="none" stroke="#F79A3E" stroke-width="9" stroke-linecap="round"/></g>
      <ellipse cx="60" cy="104" rx="33" ry="26" fill="#F79A3E" stroke="#2B0D2E" stroke-width="2.5"/>
      <ellipse cx="60" cy="110" rx="18" ry="15" fill="#FFE6C7"/>
      <ellipse cx="44" cy="126" rx="11" ry="6.5" fill="#FFE6C7" stroke="#2B0D2E" stroke-width="2.5"/>
      <g class="cam-tay">
        <ellipse cx="94" cy="80" rx="9" ry="13" fill="#F79A3E" stroke="#2B0D2E" stroke-width="2.5"/>
        <ellipse cx="94" cy="74" rx="7" ry="6" fill="#FFE6C7"/>
        <circle cx="94" cy="75" r="2.6" fill="#F28BA8"/>
      </g>
      <path d="M26 44 31 9l24 22Z" fill="#F79A3E" stroke="#2B0D2E" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M33 35 35 17l13 13Z" fill="#F7B5C9"/>
      <path d="M94 44 89 9 65 31Z" fill="#F79A3E" stroke="#2B0D2E" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M87 35 85 17 72 30Z" fill="#F7B5C9"/>
      <ellipse cx="60" cy="52" rx="39" ry="32" fill="#F79A3E" stroke="#2B0D2E" stroke-width="2.5"/>
      <path d="M60 22v10M49 24l3 9M71 24l-3 9" stroke="#C9661F" stroke-width="4" stroke-linecap="round"/>
      <ellipse cx="60" cy="66" rx="15" ry="11" fill="#FFE6C7"/>
      <ellipse cx="36" cy="63" rx="6" ry="4" fill="#F28BA8" opacity=".75"/>
      <ellipse cx="84" cy="63" rx="6" ry="4" fill="#F28BA8" opacity=".75"/>
      <g class="cam-mat">
        <ellipse cx="45" cy="52" rx="6" ry="7" fill="#2B0D2E"/><circle cx="47" cy="49.5" r="2.2" fill="#fff"/>
        <ellipse cx="75" cy="52" rx="6" ry="7" fill="#2B0D2E"/><circle cx="77" cy="49.5" r="2.2" fill="#fff"/>
      </g>
      <path d="M56 61h8l-4 4Z" fill="#E5688A" stroke="#2B0D2E" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M60 65q-2 5-7 3M60 65q2 5 7 3" fill="none" stroke="#2B0D2E" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
</div>
)}

<script>
  // Hành vi của bé Cam. Lựa chọn của khách lưu trong trình duyệt của họ (localStorage).
  const doc = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const ghi = (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} };
  const docPhien = (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } };
  const ghiPhien = (k: string) => { try { sessionStorage.setItem(k, '1'); } catch {} };

  const cam = document.getElementById('cam');
  const nutBat = document.querySelector<HTMLButtonElement>('[data-cam-bat]');

  if (cam) {
    const bong = document.getElementById('cam-bong')!;
    const meo = document.getElementById('cam-meo')!;
    const trang = cam.dataset.trang || 'trang_khac';

    // Giờ Việt Nam (UTC+7), không phụ thuộc múi giờ máy khách
    const vn = new Date(Date.now() + 7 * 3600_000);
    const phut = vn.getUTCHours() * 60 + vn.getUTCMinutes();
    const ngoaiGio = phut < 8 * 60 || phut >= 21 * 60;
    const goiY = ngoaiGio ? 'ngoai_gio' : trang;

    const moBong = () => {
      cam.querySelectorAll<HTMLElement>('[data-goi-y]').forEach((el) => { el.hidden = el.dataset.goiY !== goiY; });
      bong.hidden = false;
      cam.classList.remove('nho');
      cam.classList.add('noi');
      meo.setAttribute('aria-expanded', 'true');
      setTimeout(() => cam.classList.remove('noi'), 700);
    };
    const dongBong = () => {
      bong.hidden = true;
      cam.classList.add('nho');
      meo.setAttribute('aria-expanded', 'false');
    };
    const hienCam = (moLuon: boolean) => {
      cam.hidden = false;
      requestAnimationFrame(() => cam.classList.add('vao'));
      if (moLuon) moBong(); else dongBong();
    };

    meo.addEventListener('click', () => (bong.hidden ? moBong() : dongBong()));
    cam.querySelector('[data-cam-nho]')?.addEventListener('click', () => { dongBong(); meo.focus(); });
    cam.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !bong.hidden) { dongBong(); meo.focus(); } });
    cam.querySelector('[data-cam-tat]')?.addEventListener('click', () => {
      ghi('cam-tat', '1');
      cam.hidden = true;
      if (nutBat) nutBat.hidden = false;
    });
    nutBat?.addEventListener('click', () => {
      ghi('cam-tat', null);
      nutBat.hidden = true;
      hienCam(true);
    });

    // Thỉnh thoảng vẫy tay chào
    setInterval(() => {
      cam.classList.add('chao');
      setTimeout(() => cam.classList.remove('chao'), 1600);
    }, 12000);

    if (doc('cam-tat') === '1') {
      if (nutBat) nutBat.hidden = false;
    } else {
      // Mỗi gợi ý chỉ tự bật một lần; gợi ý ngoài giờ bật lại mỗi lần mở web
      const khoa = 'cam-da-xem-' + goiY;
      const daXem = goiY === 'ngoai_gio' ? docPhien(khoa) : doc(khoa);
      setTimeout(() => {
        hienCam(!daXem);
        if (!daXem) { goiY === 'ngoai_gio' ? ghiPhien(khoa) : ghi(khoa, '1'); }
      }, 3500);
    }
  }
</script>
