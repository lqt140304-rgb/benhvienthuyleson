---
// Bé Cam: trợ lý thông tin. Câu chào theo từng trang lấy từ src/data/cam.json (sửa trong trang quản trị: "Thông tin & cài đặt" → "Bé Cam").
// Tắt hẳn bé Cam bằng cam.json → bat = false. Bé Cam chỉ hướng dẫn thông tin, không tư vấn bệnh.
import Icon from './Icon.astro';
import BeCamHinh from './ls/BeCamHinh.astro';
import cam from '../data/cam.json';
import tt from '../data/thong_tin.json';

interface Props { trang?: string }
const { trang = 'trang_khac' } = Astro.props;
const loai = trang in cam ? trang : 'trang_khac';
const chao = [['ngoai_gio', (cam as any).ngoai_gio], [loai, (cam as any)[loai]]].filter(([, c]) => c);
const hoi: [string, string, string][] = [['dich-vu', 'stethoscope', 'Xem dịch vụ'], ['bang-gia', 'tag', 'Tra cứu bảng giá'], ['dat-lich', 'calendar', 'Đặt lịch khám'], ['lien-he', 'phone', 'Xem liên hệ'], ['chi-duong', 'dinhvi', 'Chỉ đường']];
---
{cam.bat && (
<div class="cam" id="cam">
  <button type="button" class="cam-nut" id="cam-nut" aria-expanded="false" aria-controls="cam-bang" aria-haspopup="dialog" aria-label="Mở trợ lý thông tin Bé Cam"><BeCamHinh /></button>
  <div class="cam-nen" id="cam-nen" hidden></div>
  <section class="cam-bang" id="cam-bang" role="dialog" aria-modal="false" aria-labelledby="cam-ten" hidden>
    <header class="cam-dau">
      <span class="cam-avt"><BeCamHinh /></span>
      <div><b id="cam-ten">Bé Cam</b><small>Trợ lý thông tin của Lê Sơn</small></div>
      <button type="button" class="cam-dong" id="cam-dong" aria-label="Đóng Bé Cam"><Icon name="close" size={20} /></button>
    </header>
    <div class="cam-than" id="cam-than">
      {chao.map(([k, c]) => <p class="cam-chao" data-goi-y={k} hidden>{c}</p>)}
      <div class="cam-tra" id="cam-tra" aria-live="polite"></div>
      <ul class="cam-ds" aria-label="Chọn thông tin">
        {hoi.map(([k, i, t]) => <li><button type="button" data-hoi={k}><span class="cam-ic"><Icon name={i} size={18} /></span><span>{t}</span><span class="cam-mui"><Icon name="phai" size={18} /></span><span class="cam-tick"><Icon name="check" size={18} /></span></button></li>)}
      </ul>
    </div>
    <footer class="cam-chan">
      <a href={`tel:${tt.dien_thoai_goi}`}><Icon name="phone" size={16} /><b>{tt.dien_thoai}</b></a>
      <small>Chỉ hướng dẫn thông tin, không tư vấn bệnh.</small>
    </footer>
  </section>
</div>
)}
