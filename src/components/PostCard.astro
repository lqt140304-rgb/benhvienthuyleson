---
// Thẻ bài tư vấn (ảnh + chuyên mục + tiêu đề)
import type { CollectionEntry } from 'astro:content';
import { u, ngay } from '../lib/site';
interface Props { bai: CollectionEntry<'tuVan'>; anh?: boolean }
const { bai, anh = true } = Astro.props;
const d = bai.data;
---
<a class="tp-the" href={u(`/tu-van/${bai.id}/`)}>
  {anh && (d.image
    ? <div class="tp-hinh"><img src={u(d.image)} alt="" loading="lazy" width="400" height="300"></div>
    : <div class="tp-hinh" aria-hidden="true">{d.chuyen_muc}</div>)}
  <div class="tp-noi">
    <span class={`tp-nhan${d.chuyen_muc === 'Chó' ? '' : ' cam'}`}>{d.chuyen_muc}</span>
    <h3>{d.title}</h3>
    <span class="tp-meta">{d.tac_gia ? `${d.tac_gia} · ` : ''}{ngay(d.date)}</span>
  </div>
</a>
