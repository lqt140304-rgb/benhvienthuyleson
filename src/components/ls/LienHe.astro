---
// Liên hệ: địa chỉ, giờ, điện thoại, Zalo + bản đồ minh hoạ (bấm mở Google Maps thật)
import Icon from '../Icon.astro';
import OIc from './OIc.astro';
import tt from '../../data/thong_tin.json';
import { choXn } from '../../lib/ls';
const diaChiNgan = tt.dia_chi.split(',').slice(0, 2).join(',');
const leTet = choXn('gio-ngay-le');
---
<section class="khoi" id="lien-he">
  <div class="khung lh">
    <div class="lh-chu">
      <p class="nhan">Liên hệ</p>
      <h2>Ghé thăm Lê Sơn</h2>
      <dl class="lh-ds" data-hien>
        <div><OIc name="pin" /><dt>Địa chỉ</dt><dd>{tt.dia_chi}</dd></div>
        <div><OIc name="clock" /><dt>Giờ mở cửa</dt><dd>{tt.gio_mo_cua}{leTet && <small class="xn-dong">{leTet.ghi_chu_hien} <span class="cho-xn">Chờ xác nhận</span></small>}</dd></div>
        <div><OIc name="phone" /><dt>Điện thoại</dt><dd><a href={`tel:${tt.dien_thoai_goi}`}>{tt.dien_thoai}</a></dd></div>
        {tt.zalo && <div><OIc name="chat" /><dt>Zalo</dt><dd><a href={tt.zalo} target="_blank" rel="noopener">Nhắn tin qua Zalo</a></dd></div>}
      </dl>
      <div class="hang-nut"><a class="nut nut-chinh" href={`tel:${tt.dien_thoai_goi}`}><Icon name="phone" size={18} />Gọi ngay</a><a class="nut nut-vien" href={tt.ban_do} target="_blank" rel="noopener"><Icon name="dinhvi" size={18} />Chỉ đường</a></div>
    </div>
    <a class="ban-do" data-hien href={tt.ban_do} target="_blank" rel="noopener" aria-label="Mở vị trí bệnh viện trên Google Maps">
      <svg class="bd-nen" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <rect width="400" height="300" fill="#F7F3F6"/>
        <g fill="#EEE7EE"><rect x="14" y="16" width="96" height="62" rx="8"/><rect x="14" y="96" width="70" height="80" rx="8"/><rect x="14" y="196" width="104" height="90" rx="8"/><rect x="126" y="16" width="84" height="40" rx="8"/><rect x="290" y="16" width="96" height="58" rx="8"/><rect x="300" y="196" width="86" height="90" rx="8"/><rect x="132" y="196" width="76" height="90" rx="8"/></g>
        <rect x="290" y="92" width="96" height="86" rx="8" fill="#E3F1F0"/>
        <circle cx="330" cy="130" r="10" fill="#CFE6E4"/><circle cx="356" cy="150" r="7" fill="#CFE6E4"/>
        <path d="M-10 86 C90 80 160 92 410 84" stroke="#fff" stroke-width="12" fill="none"/>
        <path d="M-10 186 C120 190 200 180 410 188" stroke="#fff" stroke-width="12" fill="none"/>
        <path d="M120 -10 C116 100 124 200 118 310" stroke="#fff" stroke-width="9" fill="none"/>
        <path d="M268 -10 L238 310" stroke="#fff" stroke-width="24" fill="none"/>
        <path d="M268 -10 L238 310" stroke="#F3DCC8" stroke-width="2" stroke-dasharray="10 10" fill="none"/>
        <text x="0" y="0" transform="translate(247 262) rotate(-84.6)" font-size="11" font-weight="500" fill="#7D7684" font-family="Be Vietnam Pro, sans-serif" letter-spacing=".4">Khuất Duy Tiến</text>
      </svg>
      <span class="bd-nhan">Bản đồ minh hoạ</span>
      <span class="bd-ghim"><Icon name="pin" size={22} /></span>
      <span class="bd-the"><b>{tt.ten}</b><small>{diaChiNgan}</small></span>
      <span class="bd-mo">Mở Google Maps <Icon name="ngoai" size={16} /></span>
    </a>
  </div>
</section>
