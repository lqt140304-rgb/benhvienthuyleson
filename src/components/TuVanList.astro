---
// Danh sách bài tư vấn, dùng chung cho /tu-van/, /tu-van/cho/, /tu-van/meo/
import Layout from '../layouts/Layout.astro';
import TrangDau from './ls/TrangDau.astro';
import PostCard from './PostCard.astro';
import { u, baiTuVan } from '../lib/site';
interface Props { loai?: 'Chó' | 'Mèo' }
const { loai } = Astro.props;
const ds = (await baiTuVan()).filter((b) => !loai || b.data.chuyen_muc === loai);
const tieuDe = loai ? `Cẩm nang chăm sóc ${loai.toLowerCase()}` : 'Cẩm nang thú cưng';
const tabs = [{ ten: 'Tất cả', href: '/tu-van/', on: !loai }, { ten: 'Chó', href: '/tu-van/cho/', on: loai === 'Chó' }, { ten: 'Mèo', href: '/tu-van/meo/', on: loai === 'Mèo' }];
const crumbs = loai
  ? [{ ten: 'Trang chủ', href: u('/') }, { ten: 'Cẩm nang thú cưng', href: u('/tu-van/') }, { ten: loai }]
  : [{ ten: 'Trang chủ', href: u('/') }, { ten: 'Cẩm nang thú cưng' }];
---
<Layout title={tieuDe} description={`Bài tư vấn ${loai ? 'chăm sóc ' + loai.toLowerCase() : 'chăm sóc chó mèo'} do bác sĩ Bệnh viện thú y Lê Sơn biên soạn: phòng bệnh, dinh dưỡng, dấu hiệu cần đi khám.`} hienTai="cam-nang" cam="trang_khac">
  <TrangDau crumbs={crumbs} nhan="Cẩm nang" tieuDe={tieuDe} moTa="Kiến thức chăm sóc do bác sĩ bệnh viện biên soạn, viết dễ hiểu cho khách hàng." />
  <section class="khoi" style="padding-top:24px">
    <div class="khung">
      <nav class="tp-loc" aria-label="Chuyên mục">{tabs.map((t) => <a href={u(t.href)} aria-current={t.on ? 'page' : undefined}>{t.ten}</a>)}</nav>
      {ds.length > 0
        ? <div class="tp-luoi">{ds.map((b) => <PostCard bai={b} />)}</div>
        : <p class="tp-rong">Bài viết đang được bác sĩ chuẩn bị. Bạn quay lại sau nhé!</p>}
    </div>
  </section>
</Layout>
