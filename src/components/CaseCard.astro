---
// Thẻ ca bệnh trong Nhật ký ca bệnh. Ảnh nhạy cảm hiện mờ ở danh sách.
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { u, ngay } from '../lib/site';
interface Props { ca: CollectionEntry<'caBenh'> }
const { ca } = Astro.props;
const d = ca.data;
const bia = d.image || d.anh[0]?.src || '';
---
<a class="tp-the" href={u(`/nhat-ky-ca-benh/${ca.id}/`)} data-loai={d.loai}>
  <div class={`tp-hinh${d.nhay_cam && bia ? ' mo' : ''}`}>
    {bia ? <img src={u(bia)} alt="" loading="lazy" width="400" height="300"> : <span aria-hidden="true">Chưa có ảnh</span>}
    {d.nhay_cam && <span class="tp-mo-nhan"><Icon name="eye" size={22} />Ảnh phẫu thuật / vết thương<br>Bấm để xem ca bệnh</span>}
  </div>
  <div class="tp-noi">
    <span class={`tp-nhan${d.loai === 'Chó' ? '' : ' cam'}`}>{d.loai}</span>
    <h3>{d.title}</h3>
    <span class="tp-meta">{ngay(d.date)}{d.anh.length > 0 ? ` · ${d.anh.length} ảnh` : ''}</span>
  </div>
</a>
