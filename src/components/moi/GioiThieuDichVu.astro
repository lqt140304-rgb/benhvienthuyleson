---
// Giới thiệu + Dịch vụ nổi bật gộp một khu (giao diện mới), theo mẫu "Trọng tâm hình ảnh" (chủ dự án 12/10/2026).
// Máy tính: ảnh bên trái 60%, nội dung bên phải 40%; điện thoại: ảnh trên, nội dung dưới. Tiêu đề Newsreader đè lên ảnh, có lớp tím sẫm dần để chữ luôn dễ đọc.
// Chưa có ảnh thật (thong_tin.json › anh_tap_the) thì hiện khung chờ kẻ sọc "Ảnh thực tế · sắp cập nhật"; KHÔNG dùng ảnh minh hoạ / ảnh mạng.
// Viết bằng Tailwind v4 (tiền tố tw:, xem src/styles/moi/tailwind.css); màu, phông, bo góc lấy từ biến CSS của token.css.
// Id: giữ #gioi-thieu cho cả khu; #dich-vu là mốc ở danh sách ba điểm / dịch vụ nổi bật (menu "Dịch vụ" cuộn tới đây).
import tt from '../../data/thong_tin.json';
import { u } from '../../lib/site';
import Icon from '../Icon.astro';
import Mui from './Mui.astro';
const ngan = tt.gioi_thieu_ngan || 'Lê Sơn là bệnh viện thú y dành cho chó mèo tại Thanh Xuân, Hà Nội. Khám, chẩn đoán và chăm sóc được thực hiện tại cùng một nơi.';
const diem = [
  { icon: 'stethoscope', ten: 'Chẩn đoán tại viện', mo: 'Siêu âm, X-quang và các xét nghiệm thường dùng.', href: '/dich-vu/' },
  { icon: 'scalpel', ten: 'Từ phòng bệnh đến phẫu thuật', mo: 'Tiêm phòng, triệt sản, phẫu thuật và gửi nội trú.', href: '/dich-vu/' },
  { icon: 'tag', ten: 'Tham khảo chi phí trước khi đến', mo: 'Bảng giá công khai theo nhóm dịch vụ và cân nặng.', href: '/bang-gia/' },
];
---
<section class="khoi" id="gioi-thieu" aria-labelledby="gt-tieu-de">
  <div class="khung">
    <div class="tw:grid tw:grid-cols-1 tw:gap-8 tw:lg:grid-cols-[3fr_2fr] tw:lg:gap-12 tw:lg:items-stretch">
      <div data-hien="mo-man" class="tw:min-w-0">
        <figure class="tw:relative tw:m-0 tw:flex tw:aspect-[4/3] tw:w-full tw:flex-col tw:justify-end tw:overflow-hidden tw:rounded-(--r-anh) tw:border tw:border-(--ke) tw:bg-(--kem-dam) tw:bg-[repeating-linear-gradient(135deg,transparent_0_11px,var(--ke)_11px_12px)] tw:lg:aspect-auto tw:lg:h-full tw:lg:min-h-[600px]">
          {tt.anh_tap_the
            ? <img class="tw:absolute tw:inset-0 tw:size-full tw:object-cover" src={u(tt.anh_tap_the)} alt={`Đội ngũ ${tt.ten}`} loading="lazy" width="1200" height="800">
            : (
              <div class="tw:absolute tw:inset-x-0 tw:top-[16%] tw:flex tw:flex-col tw:items-center tw:gap-3 tw:text-(--phu)">
                <svg class="tw:text-(--tim)" aria-hidden="true" focusable="false" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"></path><circle cx="12" cy="13" r="3.5"></circle></svg>
                <span class="tw:text-[15px] tw:font-medium">Ảnh thực tế · sắp cập nhật</span>
              </div>
            )}
          <div class="tw:pointer-events-none tw:absolute tw:inset-0 tw:bg-linear-to-t tw:from-[#2A102E]/95 tw:via-[#2A102E]/75 tw:via-45% tw:to-transparent" aria-hidden="true"></div>
          <figcaption class="tw:relative tw:p-6 tw:sm:p-8 tw:lg:p-10">
            <h2 id="gt-tieu-de" class="tw:m-0 tw:max-w-[14em] tw:font-(family-name:--f-tieu-de) tw:text-[clamp(34px,4.6vw,56px)] tw:leading-[1.08] tw:font-medium tw:text-white">Giới thiệu Bệnh viện thú y Lê Sơn</h2>
          </figcaption>
        </figure>
      </div>
      <div class="tw:flex tw:min-w-0 tw:flex-col tw:justify-center tw:gap-8">
        <div data-hien="len">
          <p class="tw:m-0 tw:text-[clamp(18px,1.6vw,21px)] tw:leading-[1.7] tw:text-(--chu)">{ngan}</p>
        </div>
        <ul id="dich-vu" class="tw:m-0 tw:scroll-mt-28 tw:list-none tw:border-t tw:border-(--ke) tw:p-0">
          {diem.map((d) => (
            <li class="tw:border-b tw:border-(--ke)" data-hien="ke">
              <a class="tw:group tw:flex tw:items-start tw:gap-4 tw:py-5 tw:no-underline tw:text-(--tim)" href={u(d.href)}>
                <span class="tw:mt-0.5 tw:grid tw:size-11 tw:shrink-0 tw:place-items-center tw:rounded-lg tw:bg-(--kem-dam) tw:text-(--tim)" aria-hidden="true"><Icon name={d.icon} size={24} /></span>
                <span class="tw:grid tw:min-w-0 tw:gap-1">
                  <b class="tw:font-(family-name:--f-tieu-de) tw:text-[20px] tw:leading-[1.3] tw:font-medium tw:text-(--tim) tw:group-hover:underline tw:group-focus-visible:underline">{d.ten}</b>
                  <span class="tw:text-[16px] tw:leading-[1.55] tw:text-(--phu)">{d.mo}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-x-8 tw:gap-y-2" data-hien="len">
          <a class="lien-ket" href={u('/gioi-thieu/')}>Tìm hiểu thêm về bệnh viện<Mui size={16} /></a>
          <a class="lien-ket" href={u('/dich-vu/')}>Xem tất cả dịch vụ<Mui size={16} /></a>
        </div>
      </div>
    </div>
  </div>
</section>
