---
// Biểu tượng nét mảnh dùng chung (Lucide, giấy phép ISC, cộng nét vẽ riêng). Bộ của giao diện mới: lưới 24, nét 1.9, mỗi icon tối đa một mảng tô mềm.
import { L } from '../lib/ls-icons';
interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class={cls ? `ic ${cls}` : 'ic'} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={L[name] ?? L.stethoscope}></svg>
