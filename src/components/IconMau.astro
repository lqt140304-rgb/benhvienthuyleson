---
// Biểu tượng màu vẽ tay cho nhóm dịch vụ và mục Chó / Mèo, cùng nét với bé Cam (viền đậm, màu tươi).
// Hình nằm giữa khung nhờ KHUNG đã đo sẵn. Mỗi hình có một chuyển động nhỏ (bọt bay, tim đập, kéo cắt...),
// tự tắt khi máy bật "giảm chuyển động".
import { HINH, KHUNG } from '../lib/iconMau';
interface Props { name: string; size?: number }
const { name, size = 48 } = Astro.props;
const ten = HINH[name] ? name : 'stethoscope';
---
<svg class={`im im-${ten}`} viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" focusable="false"><g transform={KHUNG[ten]} set:html={HINH[ten]} /></svg>
