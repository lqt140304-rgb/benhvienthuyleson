---
// Khung chung mọi trang (giao diện mới): thẻ SEO, đầu trang, chân trang, thanh liên hệ nhanh, bé Cam, script giao diện.
// CSS theo công tắc GIAO_DIEN (src/lib/site.ts): nạp bằng ?url để chỉ MỘT bộ được đưa vào trang (import thường sẽ gộp cả hai).
import cssR36 from '../styles/r36.css?url';
import cssMoi from '../styles/moi/index.css?url';
import cssTw from '../styles/moi/tailwind.css?url';
import HeaderR36 from '../components/ls/Header.astro';
import HeaderMoi from '../components/moi/Header.astro';
import Footer from '../components/ls/Footer.astro';
import ThanhDuoi from '../components/ls/ThanhDuoi.astro';
import Cam from '../components/Cam.astro';
import tt from '../data/thong_tin.json';
import { u, GIAO_DIEN } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  cam?: string;
  article?: boolean;
  /** 'chu' = trang chủ (mục menu cuộn tới khu trong trang); 'khac' = các trang còn lại */
  trang?: 'chu' | 'khac';
  /** Mục menu của trang hiện tại (xem lib/menu.ts) */
  hienTai?: string;
}
const moi = GIAO_DIEN === 'moi';
const { title, description, image, noindex = false, cam = 'trang_khac', article = false, trang = 'khac', hienTai = '' } = Astro.props;

const tieuDe = title ? `${title} | ${tt.ten}` : `${tt.ten} – Khám chữa bệnh, tư vấn chăm sóc chó mèo`;
const moTa = description || `Khám, tiêm phòng, phẫu thuật, spa, nội trú và cấp cứu 24/24 cho chó mèo tại ${tt.dia_chi}. Đọc bài tư vấn chăm sóc từ bác sĩ thú y.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const anh = new URL(image ? u(image) : u('/img/og.jpg'), Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'VeterinaryCare',
  name: tt.ten,
  telephone: tt.dien_thoai_goi,
  address: { '@type': 'PostalAddress', streetAddress: '101 Khuất Duy Tiến', addressLocality: 'Thanh Xuân', addressRegion: 'Hà Nội', addressCountry: 'VN' },
  openingHours: 'Mo-Su 08:00-21:00',
  url: new URL(u('/'), Astro.site).href,
  image: new URL(u('/img/logo.jpg'), Astro.site).href,
  hasMap: tt.ban_do,
};
// Dữ liệu cho trợ lý Bé Cam (thông tin thật của bệnh viện + đường dẫn đã ghép base)
const duLieuCam = {
  dien_thoai: tt.dien_thoai, tel: `tel:${tt.dien_thoai_goi}`, gio: tt.gio_mo_cua, dia_chi: tt.dia_chi, ban_do: tt.ban_do,
  href: { 'dich-vu': u('/dich-vu/'), 'bang-gia': u('/bang-gia/'), 'dat-lich': u('/dat-lich/'), 'lien-he': u('/lien-he/') },
};
---
<!doctype html>
<html lang="vi" data-giao-dien={moi ? 'moi' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{moi
  ? /* Giao diện mới: bật hiệu ứng cả khi giảm chuyển động (lúc đó giam-chuyen-dong.css chỉ để lại đổi độ mờ 160ms); script hỏng / chưa tải sau 3s thì gỡ để nội dung không bị ẩn */
    <script is:inline>(function(){var h=document.documentElement;if('IntersectionObserver' in window){h.classList.add('co-hieu-ung');setTimeout(function(){if(!window.__hieuUngSan)h.classList.remove('co-hieu-ung');},3000);}})();</script>
  : <script is:inline>(function(){var h=document.documentElement;if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){h.classList.add('co-hieu-ung');setTimeout(function(){if(!window.__hieuUngSan)h.classList.remove('co-hieu-ung');},3000);}})();</script>}
<title>{tieuDe}</title>
<meta name="description" content={moTa}>
<link rel="canonical" href={canonical.href}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:type" content={article ? 'article' : 'website'}>
<meta property="og:site_name" content={tt.ten}>
<meta property="og:locale" content="vi_VN">
<meta property="og:title" content={title || tt.ten}>
<meta property="og:description" content={moTa}>
<meta property="og:url" content={canonical.href}>
<meta property="og:image" content={anh.href}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#5A1E5E">
<link rel="icon" type="image/png" href={u('/img/favicon.png')}>
<link rel="apple-touch-icon" href={u('/img/apple-touch-icon.png')}>
<link rel="sitemap" href={u('/sitemap-index.xml')}>
{moi ? (
  <>
    {/* Phông tự chứa (public/fonts); tải trước phông tiêu đề h1 */}
    <link rel="preload" href={u('/fonts/newsreader-latin-500-normal.woff2')} as="font" type="font/woff2" crossorigin>
    <link rel="preload" href={u('/fonts/newsreader-vietnamese-500-normal.woff2')} as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href={cssMoi}>
    <link rel="stylesheet" href={cssTw}>
  </>
) : (
  <>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap">
    <link rel="stylesheet" href={cssR36}>
  </>
)}
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</head>
<body data-trang={trang}>
<a class="bo-qua" href="#noi-dung">Bỏ qua đến nội dung</a>
{moi ? <HeaderMoi trang={trang} hienTai={hienTai} /> : <HeaderR36 trang={trang} hienTai={hienTai} />}
<main id="top">
  <slot />
</main>
<Footer trang={trang} />
<ThanhDuoi />
<Cam trang={cam} />
<script type="application/json" id="du-lieu-cam" set:html={JSON.stringify(duLieuCam).replace(/</g, '\\u003c')}></script>
<script>import '../scripts/ui.js';</script>
{moi && <script>import '../scripts/hieu-ung/index.js';</script>}
</body>
</html>
